# ===== 模型服务（OpenAI 兼容接口，DeepSeek / 通义 / Moonshot / OpenAI 均可）=====
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=2400

# ===== 后台管理密码（上线前务必修改）=====
ADMIN_PASSWORD=admin888

# ===== 数据库 =====
# 留空：使用本地 SQLite（data/app.db），适合本地开发
# 填写：使用云 Postgres（如 Neon 免费版），适合 Streamlit Cloud 等无持久磁盘的环境
# 格式：postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ===== 站点地址（支付回跳用，必须是公网可访问的 https 域名）=====
SITE_URL=https://your-domain.com
# docker compose 用：Caddy 自动申请 HTTPS 的域名（本地调试可留空）
DOMAIN=your-domain.com

# ===== 在线支付（易支付协议，个人可申请：虎皮椒 / 迅虎 / 彩虹易支付等）=====
# 未填写则自动降级为「联系客服购买」，不影响正常使用
EPAY_URL=https://pay.example.com
EPAY_PID=10001
EPAY_KEY=your_epay_key

# ===== 产品参数（一般不用改）=====
MAX_INPUT_CHARS=8000
MAX_REFINES=20
SUPPORT_TEXT=如需购买或续费，请联系客服微信：your_wechat
